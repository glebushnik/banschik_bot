TELEGRAM_BOT_TOKEN=
# Required: comma-separated numeric group IDs. No groups are allowed when empty.
ALLOWED_CHAT_IDS=-1001234567890
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Choose a model supporting tool calls.
LLM_MODEL=google/gemini-2.5-flash
SYSTEM_PROMPT_FILE=./prompts/system.txt
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1800
LLM_MAX_TOOL_ROUNDS=3
LLM_CONCURRENCY=2
REPLY_COOLDOWN_SECONDS=5
# Only this API uses a remote model. Embeddings run locally on CPU.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_THREADS=2
EMBEDDING_BATCH_SIZE=16
INDEX_INTERVAL_SECONDS=2
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=8
RECENT_MESSAGES=20
CONTEXT_MAX_CHARS=24000
DATA_DIR=./data
MODEL_CACHE_DIR=./data/models
BACKUP_DIR=./backups
BACKUP_TIMEZONE=Europe/Moscow
BACKUP_HOUR=3
BACKUP_MINUTE=0
# Keep snapshots for today and the preceding 2 calendar days.
BACKUP_RETENTION_DAYS=3
WEB_SEARCH_ENABLED=true
# Docker: http://searxng:8080; local Python: http://127.0.0.1:8080
SEARXNG_URL=http://127.0.0.1:8080
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5
